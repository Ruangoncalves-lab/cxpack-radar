# Modelo de arquivo de segredos do Streamlit
# Copie este conteúdo para .streamlit/secrets.toml e preencha com suas chaves reais

# Chave API do Google Gemini (Obtenha em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY = "SUA_CHAVE_GEMINI_AQUI"

# URL do Banco de Dados (Opcional - Se não informada, usa SQLite local automaticamente)
# DATABASE_URL = "postgresql://usuario:senha@host:5432/cxpack_radar"

# Configurações do Supabase (Opcional - Fase 6)
# SUPABASE_URL = "https://seu-projeto.supabase.co"
# SUPABASE_KEY = "sua-chave-anonima-supabase"
